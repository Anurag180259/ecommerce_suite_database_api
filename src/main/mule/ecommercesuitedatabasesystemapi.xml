    <flow name="post:\orders:application\json:ecommercesuitedatabasesystemapi-config">
        <logger level="INFO" message="#[&quot;Request received to place new order orderId:&quot; ++ payload.orderId]" />
        <try doc:name="Try" doc:id="cdd5e7bc-c466-4995-ae66-8d2135baccb4" transactionalAction="ALWAYS_BEGIN">
            <db:insert doc:name="Insert" doc:id="2697919d-05fb-4b1d-bad2-ae521eabf6e3" config-ref="Database_Config" target="temp">
                <db:sql><![CDATA[insert into orders(orderId, orderDate, orderStatus, totalOrderValue, userId, deliveryPincode, expDeliveryDate, transactionId, paymentStatus)
values(:orderId, :orderDate, :orderStatus, :totalOrderValue, :userId, :deliveryPincode, :expDeliveryDate, :transactionId, :paymentStatus);]]></db:sql>
                <db:input-parameters><![CDATA[#[{
	orderId:payload.orderId,
	orderDate:now() as Date,
	orderStatus:payload.orderStatus,
	totalOrderValue:payload.totalOrderValue,
	userId:payload.userId,
	deliveryPincode:payload.deliveryPincode,
	expDeliveryDate:(now() as Date) + (payload.deliveryTime as Period),
	transactionId:payload.transactionId,
	paymentStatus:payload.paymentStatus
}]]]></db:input-parameters>
            </db:insert>
            <foreach doc:name="For Each" doc:id="7e40b283-bd4a-4b5d-b479-4235fe254667" collection="#[payload.listOfItems]">
                <db:insert doc:name="Insert" doc:id="51299458-3535-4816-84bc-99faf4610308" config-ref="Database_Config" target="temp">
                    <db:sql><![CDATA[insert into orderItems(orderId, productId, priceAtPurchase, quantity, orderItemId, storeId)
values(:orderId, :productId, :priceAtPurchase, :quantity, :orderItemId, :storeId);]]></db:sql>
                    <db:input-parameters><![CDATA[#[{
	orderId:payload.orderId,
	orderItemId:payload.orderItemId,
	productId:payload.productId,
	priceAtPurchase:payload.priceAtPurchase,
	quantity:payload.quantity,
	storeId:payload.storeId
}]]]></db:input-parameters>
                </db:insert>
                <db:update doc:name="Update" doc:id="0d3f91fd-4313-497d-986c-a14b35b91bb1" config-ref="Database_Config">
                    <db:sql><![CDATA[update products
set stock=stock - :quantity
where productId=:productId;]]></db:sql>
                    <db:input-parameters><![CDATA[#[{
	quantity:payload.quantity,
	productId:payload.productId
}]]]></db:input-parameters>
                </db:update>
            </foreach>
            <choice doc:name="Choice" doc:id="1ec68e6f-7cc0-4f63-9ce9-31f5cfe6c0d6">
                <when expression="#[payload.isCart]">
                    <db:delete doc:name="Delete" doc:id="22ec9909-2f30-489c-a79f-f3aca443f096" config-ref="Database_Config" target="temp">
                        <db:sql><![CDATA[delete from carts where userId=:userId;]]></db:sql>
                        <db:input-parameters><![CDATA[#[{
	userId:payload.userId
}]]]></db:input-parameters>
                    </db:delete>
                </when>
            </choice>
        </try>
    </flow>
