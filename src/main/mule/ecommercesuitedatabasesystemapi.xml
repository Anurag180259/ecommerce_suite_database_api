    <flow name="post:\stores:application\json:ecommercesuitedatabasesystemapi-config">
        <logger level="INFO" message="POST/process/stores called database api. adding new store to storeData table" />
        <db:insert doc:name="addNewStore" doc:id="8f00dd78-b025-4843-ad2b-ca3a903d43e8" config-ref="Database_Config">
            <db:sql><![CDATA[insert into storeData(storeName, storeId, accountHolderName, gstin, accountNumber, userId)
values(:storeName, :storeId, :name, :gstin, :accNumber, :userId)]]></db:sql>
            <db:input-parameters><![CDATA[#[{
	storeName:payload.storeName,
	storeId:payload.storeId,
	name:payload.accountHolderName,
	gstin:payload.gstin,
	accNumber:payload.accountNumber,
	userId:payload.userId
}]]]></db:input-parameters>
        </db:insert>
        <error-handler>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="b4a670ff-f767-491f-9a49-98b4b892c65f" type="DB:QUERY_EXECUTION" when="#[error.description contains &quot;storeName&quot;]">
                <set-variable value="409" doc:name="httpStatus" doc:id="3e2ce298-f03a-4104-b264-449c4252d882" variableName="httpStatus" />
            </on-error-propagate>
        </error-handler>
    </flow>
