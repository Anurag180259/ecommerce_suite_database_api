#%RAML 1.0 Library

types:
  postUserRequestBody:
    properties:
        userId:
          type: string
          required: true
          pattern: ^(S|B|A)-[0-9A-Fa-f]{6}$
        firstName:
          type: string
          required: true
          pattern: ^[a-zA-Z]+$
        lastName:
          type: string
          required: true
          pattern: ^[a-zA-Z]+$
        email:
          type: string
          required: true
          pattern: ^[\w.-]+@[\w.-]+\.\w+$
        phoneNo:
          type: string
          required: false
          pattern: ^[0-9]{10}$
        city:
          type: string
          required: true
        role:
          type: string
          required: true
          enum: [buyer, seller, admin]
        password:
          type: string
          required: true
  postStoresRequestBody:
    properties:
      storeName:
        type: string
        required: true
      gstin:
        type: string
        required: true
        pattern: ^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$
      accountNumber:
        type: string
        required: true
        pattern: ^[0-9]{9,18}$
      accountHolderName:
        type: string
        required: true
      storeId:
        type: string
        required: true
        pattern: ^ST-[0-9a-fA-F]{6}$
      userId:
        type: string
        required: true
        pattern: ^S-[0-9a-fA-F]{6}$
  patchStoresRequestBody:
    properties:
      storeName:
        type: string
        required: false
      gstin:
        type: string
        required: false
        pattern: ^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$
      accountNumber:
        type: string
        required: false
        pattern: ^[0-9]{9,18}$
      accountHolderName:
        type: string
        required: false
      verificationStatus:
        type: string
        required: false
        enum: [verified, unverified, rejected]
  postProductRequestBody:
    properties:
      productName:
        type: string
        required: true
      productId:
        type: string
        required: true
      storeId:
        type: string
        required: true
      brand:
        type: string
        required: true
      stock:
        type: number
        required: true
      price:
        type: number
        required: true
      category:
        type: string
        required: true
      subCategory:
        type: string
        required: false
      details:
        type: string
        required: true
        maxLength: 255
  patchProductRequestBody:
    properties:
      productName:
        required: false
        type: string
      brand:
        required: false
        type: string
      price:
        required: false
        type: number
      category:
        required: false
        type: string
      subCategory:
        required: false
        type: string
      details:
        required: false
        type: string
      quantity:
        required: false
        type: number
  postCartRequestBody:
    properties:
      cartItemId:
        type: string
        required: true
      productId:
        type: string
        required: true
      userId:
        type: string
        required: true
      quantity:
        type: number
        required: true
  patchCartRequestBody:
    properties:
      quantity:
        type: number
        required: true
  postOrderRequestBody:
    properties:
      orderId:
        type: string
        pattern: ^OD-[0-9a-fA-F]{6}$
      orderStatus:
        type: string
        enum: [pending, confirmed]
      totalOrderValue:
        type: number
      userId:
        type: string
        pattern: ^B-[0-9a-fA-F]{6}$
      deliveryPincode:
        type: string
        pattern: ^[0-9]{6}$
      deliveryTime:
        type: string
      transactionId: 
        type: string
        pattern: ^PAY-[0-9a-fA-F]{8}$
      paymentStatus:
        type: string
        enum: [success, pending]
      isCart:
        required: true
        type: boolean
      listOfItems:
        type: array
        items:
          properties:
            orderId:
              type: string
              pattern: ^OD-[0-9a-fA-F]{6}$
            productId: 
              type: string
              pattern: ^P-[0-9a-fA-F]{6}$
            priceAtPurchase:
              type: number
            quantity:
              type: integer
              minimum: 1
            orderItemId:
              type: string
              pattern: ^OI-[0-9a-fA-F]{6}$
  postOrderItemsRequestBody:
    properties:
      orderId:
        type: string
        pattern: ^OD-[0-9a-fA-F]{6}$
      productId: 
        type: string
        pattern: ^P-[0-9a-fA-F]{6}$
      priceAtPurchase:
        type: number
      quantity:
        type: integer
        minimum: 1
      orderItemId:
        type: string
        pattern: ^OI-[0-9a-fA-F]{6}$
      storeId:
        type: string
        pattern: ^ST-[0-9a-fA-F]{6}$

traits:
  getUsersByEmail:
    queryParameters:
      email:
        type: string
        required: true
        pattern: ^[\w.-]+@[\w.-]+\.\w+$
  getUsersByRole:
    queryParameters:
      role:
        type: string
        required: true
        enum: [admin, buyer, seller]
  getProductsByFilters:
    queryParameters:
      storeId:
        type: string
        required: false
        pattern: ^ST-[0-9A-Fa-f]{6}$
      brand:
        type: string
        required: false
      category:
        type: string
        required: false
      subCategory:
        type: string
        required: false
      maxPrice: 
        type: number
        required: false
      minPrice: 
        type: number
        required: false
      inStock:
        type: boolean
        required: false
      storeName:
        type: string
        required: false
      minRatings:
        type: number
        required: false
  deleteCartByFilters:
    queryParameters:
      userId:
        type: string
        required: false
      cartItemId:
        type: string
        required: false
  getCartByFilters:
    queryParameters:
      userId:
        required: true
        type: string
      productId: 
        required: false
        type: string

















